# Copy to .env and export these (or use your host's env settings). Never commit real values.
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Comma-separated browser origins allowed to call this API. Must include the frontend's origin.
CORS_ORIGINS=http://localhost:3000
# true only when behind a trusted reverse proxy (Nginx/Cloudflare); then the real IP is taken from X-Forwarded-For.
TRUST_PROXY=false

# yt-dlp / ffmpeg
YTDLP_PATH=yt-dlp
YTDLP_FFMPEG_LOCATION=
# YouTube player clients used by yt-dlp. Fewer clients = faster info. If some videos lose formats, switch back to "default,mweb".
YTDLP_YT_CLIENTS=default
# Optional faster client for the info call only. WARNING: android_vr returns an incomplete quality list (only ~360p), so it is OFF (empty) by default.
YTDLP_INFO_CLIENTS=
# Persistent folder for yt-dlp cache (mount a volume so restarts stay fast). Empty = yt-dlp default.
YTDLP_CACHE_DIR=
# Pre-load yt-dlp/Deno once at startup so the first user is not slow.
YTDLP_WARMUP=true
# true = download reuses the info fetched for the preview (skips a 2nd slow extraction) and downloads the exact format whose size is shown.
YTDLP_REUSE_INFO=true
# true = 16 parallel connections via aria2c (much faster on throttled YouTube). Install aria2 first (e.g. `winget install aria2.aria2`) and make sure `aria2c` is in PATH.
YTDLP_ARIA2C=false
# Optional: log in cookies for yt-dlp. Fixes Instagram "empty media response" and YouTube "not a bot" errors.
# Use ONE of these (leave both empty to disable). Browser must be closed on Windows for chrome/edge.
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_FROM_BROWSER=
YTDLP_MAX_CONCURRENT=3
YTDLP_MAX_FILESIZE=2G
TMP_DIR=/tmp/vidfetch
DATA_DIR=./data

# Rate limits (per IP, per minute)
RATE_LIMIT_INFO_PER_MINUTE=30
RATE_LIMIT_DOWNLOAD_PER_MINUTE=5
RATE_LIMIT_ORDER_PER_MINUTE=10

# Highest quality available without Premium. 4320 (the original default) means nothing is locked.
FREE_MAX_QUALITY=4320

# Razorpay (https://dashboard.razorpay.com). Placeholders below mean "payments not configured".
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=change_me
# At least 32 random characters. The server refuses to start in production with the placeholder.
PREMIUM_TOKEN_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_32_PLUS
PREMIUM_PRICE_PAISE=1900
PREMIUM_DAYS=30
