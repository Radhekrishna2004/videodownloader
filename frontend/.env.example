# Copy to .env.local. NEXT_PUBLIC_* values are embedded in the browser bundle: never put secrets here.

# Base URL of the Fastify backend. Its CORS_ORIGINS must include this site's origin.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: Web3Forms access key (public by design) for the review form. Empty => the form says it is not set up.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Optional: Google AdSense. Leave empty to show no ads and skip the ad-blocker check.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=
